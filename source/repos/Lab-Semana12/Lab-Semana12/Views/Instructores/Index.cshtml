@model IEnumerable<Instructor>

@{
    ViewData["Title"] = "Instructores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Instructores</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo instructor</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nombres)</th>
            <th>@Html.DisplayNameFor(model => model.Apellidos)</th>
            <th>@Html.DisplayNameFor(model => model.Especialidad)</th>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <th>@Html.DisplayNameFor(model => model.Activo)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var instructor in Model)
{
        <tr>
            <td>@instructor.Nombres</td>
            <td>@instructor.Apellidos</td>
            <td>@instructor.Especialidad</td>
            <td>@instructor.Email</td>
            <td>@(instructor.Activo ? "Sí" : "No")</td>
            <td class="text-nowrap">
                <a asp-action="Details" asp-route-id="@instructor.IdInstructor">Detalles</a> |
                <a asp-action="Edit" asp-route-id="@instructor.IdInstructor">Editar</a> |
                <a asp-action="Delete" asp-route-id="@instructor.IdInstructor">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
